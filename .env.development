# `npm run dev` always talks to the local Firebase emulators, never to production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=demo-gubbycardz
# No Google Cloud metadata server exists locally; skip the lookup (avoids a noisy warning).
METADATA_SERVER_DETECTION=none

# Auth emulator – server (Admin SDK) and browser (Firebase JS SDK).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gubbycardz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gubbycardz

# In the emulator, sign in with a fake Google account using this address.
ADMIN_EMAILS=admin@example.com

# Ordering needs Stripe test keys. They are secrets, so they go into .env.local (git-ignored), never here:
# STRIPE_SECRET_KEY=sk_test_…  and  STRIPE_WEBHOOK_SECRET=whsec_… (e.g. from `stripe listen`).
# Without them the checkout shows the button disabled – the rest of the shop works as usual.
