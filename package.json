{
  "name": "gubbycardz-webshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-gubbycardz",
    "test": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --only firestore --project demo-gubbycardz \"vitest run --project integration\"",
    "seed": "tsx scripts/seed-emulator.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
